{
  "name": "luraph-vscode",
  "displayName": "Luraph",
  "publisher": "luraph",
  "description": "Obfuscate scripts via the Luraph API from the comfort of your editor.",
  "version": "1.1.1",
  "author": "memcorrupt",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.2"
  },
  "icon": "logo.png",
  "keywords": [
    "luraph",
    "obfuscate",
    "lua obfuscator",
    "lua",
    "encrypt"
  ],
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "luraph.obfuscate",
        "title": "Obfuscate File",
        "category": "Luraph"
      }
    ],
    "configuration": {
      "title": "Luraph",
      "properties": {
        "luraph.API Key": {
          "type": "string",
          "markdownDescription": "API key to authenticate with the Luraph API. ([you can generate one here!](https://lura.ph/dashboard/account))",
          "tags": [
            "usesOnlineServices"
          ]
        },
        "luraph.Options": {
          "type": "object",
          "markdownDescription": "Autofill options: automatically saves the last-used settings so you can quickly reuse the same configuration for future obfuscation runs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vscode-test",
    "preinstall": "npx only-allow yarn",
    "deploy": "npx vsce publish",
    "package": "npx vsce package"
  },
  "dependencies": {
    "luraph": "^2.0.9"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.84.x",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.6.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luraph/luraph-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Luraph/luraph-vscode/issues"
  },
  "homepage": "https://github.com/Luraph/luraph-vscode#readme"
}
